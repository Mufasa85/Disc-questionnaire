# === Configuration du serveur DISC ===
# Copier ce fichier vers .env et adapter les valeurs

# Port du serveur HTTP
PORT=4000

# Origines autorisees pour le CORS (separees par virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# URL de connexion PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Exemples :
#   Local : postgresql://postgres:postgres@localhost:5432/disc?schema=public
#   Neon  : postgresql://user:pass@ep-xxx.region.aws.neon.tech/disc?sslmode=require
#   Supabase : postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disc?schema=public

# Cle secrete JWT (IMPORTANT : changez-la en production)
JWT_SECRET=changez-cette-cle-secrete-en-production

# Compte admin par defaut (cree au premier demarrage si la BDD est vide)
ADMIN_EMAIL=admin@disc.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrateur
