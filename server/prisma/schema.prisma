// Schéma Prisma pour le questionnaire DISC
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Une soumission de questionnaire DISC complete
/// Stocke les informations personnelles, les reponses, et les scores calcules
model Submission {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @map("created_at")

  // Informations personnelles
  nom             String
  postNom         String?  @map("post_nom")
  prenom          String?
  sexe            String?
  dateNaissance   DateTime? @map("date_naissance") @db.Date
  telephone       String?
  email           String?

  // Profil calcule
  /// Profil dominant : D, I, S ou C
  dominantProfile String   @map("dominant_profile") @db.VarChar(2)
  /// Code du profil : ex "DI", "IS", "SC"...
  code            String   @db.VarChar(2)

  // Donnees brutes (stockees en JSON)
  /// Reponses par question : { "1": "a", "2": "b", ... }
  answers         Json
  /// Scores par profil : { "D": 5, "I": 10, "S": 7, "C": 3 }
  scores          Json

  // Metadonnees
  durationSeconds Int?     @map("duration_seconds")
  ip              String?
  userAgent       String?  @map("user_agent")

  @@index([createdAt])
  @@index([dominantProfile])
  @@index([nom])
  @@map("submissions")
}
