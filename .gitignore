results/
resultats/
*.csv
!*.example.csv
*.xlsx
!*.example.xlsx

# ---------- Divers ----------
# Fichiers d'archive
*.7z
*.dmg
*.iso
*.jar
*.rar
*.zip

# Service workers / PWA (si générés)
service-worker.js
workbox-*.js
